# Netlify environment variables (set these in Netlify → Site settings → Environment variables).
# These are SERVER-SIDE only. The browser never sees them.

# The Google Apps Script web-app /exec URL, WITH the secret token appended.
# Example: https://script.google.com/macros/s/AKfy.../exec?token=YOUR_LONG_RANDOM_TOKEN
GOOGLE_SHEETS_WEBHOOK_URL=

# The public Calendly link. NOTE: on this static site the Calendly URL is not secret and is
# set directly in script.js (const CALENDLY_URL). This entry is here for reference/documentation.
CALENDLY_URL=https://calendly.com/maxim-peak-automations/30min
