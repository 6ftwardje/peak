---
import { process } from '../content/site';
const labels = ['Begrijpen', 'Bouwen', 'Verbeteren'];
---
<section class="section light-section approach" id="werkwijze" aria-labelledby="approach-title" data-approach>
  <div class="container">
    <div class="section-heading"><h2 id="approach-title">Klein beginnen.<br />Doordacht uitbouwen.</h2><p>Eerst één geschikt proces. Samen met je team testen we wat werkt. Van daaruit bouwen we verder.</p></div>
    <div class="approach-stage">
      <div class="growth-visual" aria-hidden="true" data-growth="0">
        <svg viewBox="0 0 560 420" fill="none">
          <g class="growth-base" stroke="currentColor" stroke-width="1.5"><path d="M40 340H520M80 340V305M160 340V305M240 340V305M320 340V305M400 340V305M480 340V305" /></g>
          <g class="growth-part growth-part-one"><path d="M80 300V220H160V300" /><rect x="80" y="220" width="80" height="80" /><path d="M100 260H140M120 240V280" /></g>
          <g class="growth-part growth-part-two"><path d="M160 300L240 220V140H320V220L400 300" /><rect x="240" y="140" width="80" height="80" /><path d="M260 180H300M280 160V200" /><path class="growth-connection" d="M160 260H200V180H240" /></g>
          <g class="growth-part growth-part-three"><path d="M320 180H360V100H400M400 100V20H480V100M400 100L480 180V300" /><rect x="400" y="20" width="80" height="80" /><path d="M420 60H460M440 40V80" /></g>
        </svg>
        <div class="growth-caption"><span>Een helder vertrekpunt.</span><span>Een werkende verbinding.</span><span>Ruimte om verder te bouwen.</span></div>
      </div>
      <div class="approach-story">
        <div class="approach-controls" data-approach-controls hidden>
          <div class="step-buttons" aria-label="Kies een stap">{labels.map((label, index) => <button type="button" data-step={index} aria-controls={`approach-panel-${index}`} aria-pressed={index === 0 ? 'true' : 'false'}><span>0{index + 1}</span>{label}<span class="step-progress" aria-hidden="true"></span></button>)}</div>
          <button type="button" class="cycle-toggle" data-cycle-toggle>Pauzeer animatie</button>
        </div>
        <ol class="approach-panels">{process.map((step, index) => <li id={`approach-panel-${index}`} data-panel={index}>
          <span class="approach-number" aria-hidden="true">0{index + 1}</span>
          <h3>{step.title}</h3><p>{step.text}</p><p class="team-involvement">{step.involvement}</p>
        </li>)}</ol>
      </div>
    </div>
    <p class="scope-note">Scope, timing en budget spreken we vooraf af. Kosten voor tools, AI-gebruik en eventuele ondersteuning nemen we mee in die bespreking.</p>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-approach]').forEach(section => {
    const buttons = [...section.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const panels = [...section.querySelectorAll<HTMLElement>('[data-panel]')];
    const controls = section.querySelector<HTMLElement>('[data-approach-controls]');
    const toggle = section.querySelector<HTMLButtonElement>('[data-cycle-toggle]');
    const visual = section.querySelector<HTMLElement>('[data-growth]');
    if (!controls || !toggle || !visual || !panels.length) return;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let paused = motion.matches;
    let inView = false;
    let hovering = false;
    let focused = false;
    let timer: number | undefined;
    const sync = () => {
      window.clearTimeout(timer);
      const running = !paused && !motion.matches && inView && !hovering && !focused && !document.hidden;
      section.classList.toggle('is-cycling', running);
      toggle.textContent = paused || motion.matches ? 'Start animatie' : 'Pauzeer animatie';
      toggle.disabled = motion.matches;
      if (motion.matches) toggle.textContent = 'Automatisch afspelen uit';
      if (running) timer = window.setTimeout(() => select((current + 1) % panels.length), 6500);
    };
    const select = (index: number) => {
      current = index;
      panels.forEach((panel, i) => { panel.hidden = i !== current; });
      buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === current)));
      visual.dataset.growth = String(current);
      sync();
    };
    section.classList.add('is-enhanced');
    controls.hidden = false;
    select(0);
    buttons.forEach((button, index) => button.addEventListener('click', () => { paused = true; select(index); }));
    toggle.addEventListener('click', () => { paused = !paused; sync(); });
    section.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse') { hovering = true; sync(); } });
    section.addEventListener('pointerleave', () => { hovering = false; sync(); });
    section.addEventListener('focusin', () => { focused = true; sync(); });
    section.addEventListener('focusout', event => { if (!section.contains(event.relatedTarget as Node)) { focused = false; sync(); } });
    document.addEventListener('visibilitychange', sync);
    motion.addEventListener('change', () => { paused = motion.matches; sync(); });
    new IntersectionObserver(entries => { inView = entries[0].isIntersecting; sync(); }, { threshold: .2 }).observe(section);
  });
</script>
<style>
  .approach-stage { display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(36px, 6vw, 88px); align-items: center; }
  .growth-visual { color: var(--ink); align-self: stretch; display: flex; flex-direction: column; justify-content: center; }
  .growth-visual svg { width: 100%; max-height: 400px; overflow: visible; }
  .growth-base { opacity: .25; }
  .growth-part { stroke: currentColor; stroke-width: 1.5; }
  .growth-part rect { fill: var(--accent); }
  .growth-caption { text-align: center; font-size: 15px; padding-block: 18px; }
  .growth-caption span { display: none; }
  .growth-caption span:last-child { display: block; }
  .is-enhanced .growth-part { transition: opacity 500ms ease, transform 700ms cubic-bezier(.16, 1, .3, 1); }
  .is-enhanced [data-growth='0'] .growth-part-two, .is-enhanced [data-growth='0'] .growth-part-three, .is-enhanced [data-growth='1'] .growth-part-three { opacity: .14; transform: translateY(12px); }
  .is-enhanced .growth-caption span { display: none; }
  .is-enhanced [data-growth='0'] .growth-caption span:nth-child(1), .is-enhanced [data-growth='1'] .growth-caption span:nth-child(2), .is-enhanced [data-growth='2'] .growth-caption span:nth-child(3) { display: block; }
  .step-buttons { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .step-buttons button { position: relative; padding: 14px 0 20px; text-align: left; color: var(--ink-muted); background: transparent; border: 0; border-bottom: 1px solid #111b1540; font-size: 14px; }
  .step-buttons button > span:first-child { display: block; font-size: 12px; margin-bottom: 8px; font-variant-numeric: tabular-nums; }
  .step-buttons button[aria-pressed='true'] { color: var(--ink); font-weight: 500; border-bottom-color: var(--ink); }
  .step-progress { position: absolute; bottom: -1px; left: 0; width: 100%; height: 3px; background: var(--ink); transform-origin: left; transform: scaleX(0); }
  .is-cycling button[aria-pressed='true'] .step-progress { animation: step-time 6.5s linear both; }
  @keyframes step-time { to { transform: scaleX(1); } }
  .cycle-toggle { display: block; margin-block: 16px 32px; margin-left: auto; min-height: 44px; padding: 8px 0 8px 16px; border: 0; background: transparent; color: var(--ink-muted); font-size: 12px; text-decoration: underline; text-underline-offset: .25em; }
  .cycle-toggle:disabled { opacity: 1; cursor: default; text-decoration: none; }
  .approach-panels { list-style: none; padding: 0; margin: 0; }
  .approach-panels li { padding-block: 20px; }
  .is-enhanced .approach-panels { min-height: 315px; }
  .is-enhanced .approach-panels li { padding: 0; animation: step-arrive 500ms cubic-bezier(.16, 1, .3, 1) both; }
  .approach-number { display: block; font-size: 54px; letter-spacing: -.03em; line-height: 1; margin-bottom: 20px; }
  .approach-panels h3 { font-size: clamp(26px, 2.7vw, 36px); margin-bottom: 18px; }
  .approach-panels p { color: var(--ink-muted); max-width: 52ch; }
  .team-involvement { border-top: 1px solid #111b1540; padding-top: 18px; margin-top: 24px; font-size: 14px; }
  .approach .scope-note { border-top: 1px solid #111b1540; padding-top: 28px; max-width: none; }
  @keyframes step-arrive { from { opacity: .4; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  @media (max-width: 900px) { .approach-stage { gap: 32px; } .is-enhanced .approach-panels { min-height: 390px; } }
  @media (max-width: 600px) {
    .approach-stage { grid-template-columns: 1fr; gap: 18px; }
    .growth-visual svg { max-height: 260px; }
    .growth-caption { font-size: 13px; padding-block: 8px 18px; }
    .approach-number { font-size: 44px; }
    .is-enhanced .approach-panels { min-height: 340px; }
    .cycle-toggle { margin-bottom: 22px; }
  }
</style>
