---
import type { CollectionEntry } from 'astro:content';
interface Props { image: CollectionEntry<'cases'>['data']['image']; sizes?: string; }
const { image, sizes = '(max-width: 600px) 100vw, 55vw' } = Astro.props;
---
<figure class="case-media">
  <img src={image.src} srcset={image.srcSmall ? `${image.srcSmall} 640w, ${image.src} 1280w` : undefined} sizes={sizes} width="1280" height="854" alt={image.alt} loading="lazy" decoding="async" />
  {image.placeholder && <figcaption>Sfeerbeeld · placeholder</figcaption>}
</figure>
<style>
  .case-media { margin: 0; position: relative; overflow: hidden; background: var(--surface); aspect-ratio: 3 / 2; }
  img { width: 100%; height: 100%; object-fit: cover; transition: transform 700ms cubic-bezier(.16, 1, .3, 1); }
  figcaption { position: absolute; bottom: 14px; left: 14px; background: var(--background); color: var(--foreground); padding: 5px 10px; font-size: 11px; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .case-media:hover img { transform: scale(1.025); } }
</style>
