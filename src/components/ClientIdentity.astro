---
import type { CollectionEntry } from 'astro:content';
interface Props { client: CollectionEntry<'cases'>['data']['client']; }
const { client } = Astro.props;
---
<div class="client-identity">
  <span class="client-logo"><img src={client.logo} alt={client.placeholder ? 'Plaats voor het goedgekeurde klantlogo' : client.name} width="210" height="40" loading="lazy" decoding="async" /></span>
  {client.placeholder && <span class="client-pending">Logo volgt</span>}
</div>
<style>
  .client-identity { display: flex; align-items: center; flex-wrap: wrap; gap: 12px 18px; }
  .client-logo { display: flex; align-items: center; width: 176px; min-height: 52px; padding: 10px 14px; background: var(--light); }
  .client-logo img { width: 100%; max-height: 40px; object-fit: contain; }
  .client-pending { font-size: 12px; color: var(--muted); }
</style>
