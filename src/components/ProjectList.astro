---
import type { CollectionEntry } from 'astro:content';
import Arrow from './Arrow.astro';
import CaseMedia from './CaseMedia.astro';
import ClientIdentity from './ClientIdentity.astro';
interface Props { projects: CollectionEntry<'cases'>[]; }
const { projects } = Astro.props;
---
<div class="project-stories">
  {projects.map(project => <article class="project-story">
    <a class="project-image-link" href={`/cases/${project.id}`} aria-label={`Bekijk het project: ${project.data.title}`}><CaseMedia image={project.data.image} sizes="(max-width: 600px) 100vw, 45vw" /></a>
    <div class="project-copy">
      <ClientIdentity client={project.data.client} />
      <div class="story-meta"><span>{project.data.sector}</span>{project.data.status === 'in-ontwikkeling' && <span class="project-status">In ontwikkeling</span>}</div>
      <h3><a href={`/cases/${project.id}`}>{project.data.title}</a></h3>
      <p>{project.data.summary}</p>
      <a class="text-link" href={`/cases/${project.id}`}>Bekijk het project<Arrow /></a>
    </div>
  </article>)}
</div>
<style>
  .project-story { display: grid; grid-template-columns: 1.1fr 1fr; align-items: center; gap: clamp(32px, 6vw, 88px); padding-block: 48px; border-top: 1px solid var(--border); }
  .project-story:last-child { border-bottom: 1px solid var(--border); }
  .project-story:nth-child(even) .project-image-link { order: 2; }
  .project-copy { padding-block: 12px; }
  .story-meta { display: flex; flex-wrap: wrap; gap: 12px 20px; margin-block: 30px 14px; font-size: 13px; color: var(--muted); }
  h3 { font-size: clamp(28px, 3vw, 43px); max-width: 19ch; }
  h3 a:hover { color: var(--accent); }
  .project-copy > p { margin-block: 22px 28px; color: var(--muted); max-width: 48ch; }
  .project-copy > .text-link { color: var(--accent); }
  @media (max-width: 900px) { .project-story { gap: 32px; } }
  @media (max-width: 600px) {
    .project-story { display: block; }
    .project-story { padding-block: 32px; }
    .project-story:nth-child(even) .project-image-link { order: initial; }
    .project-copy { padding-top: 24px; }
    .story-meta { margin-top: 24px; }
    .project-copy > p { font-size: 15px; margin-block: 18px 22px; }
    h3 { font-size: 30px; }
  }
</style>
